# ---------------------------------------------------------------------------
# PolyMirror environment. Copy to .env (root) and apps/backend/.env.
# NEVER commit real credentials. PolyMirror never needs a private key or seed.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
APP_ENV=development

# Data source: "demo" (generated data, simulated execution) or "live" (Polymarket public APIs)
DATA_MODE=demo

# Backend HTTP server
PORT=4000
HOST=0.0.0.0
# Comma-separated list of allowed origins (chrome-extension://<id> in production)
CORS_ORIGINS=chrome-extension://*,http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://polymirror:polymirror@localhost:5432/polymirror?schema=public

# URLs the extension uses to reach the backend (baked in at extension build time)
API_URL=http://localhost:4000
WEBSOCKET_URL=ws://localhost:4000/ws

# Polymarket public endpoints (read-only, no credentials required)
POLYMARKET_API_URL=https://data-api.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_WEB_URL=https://polymarket.com

# Outbound request budget towards Polymarket (requests per second, per backend instance)
POLYMARKET_MAX_RPS=5

# Watcher: how often followed traders are polled for new fills (ms)
WATCHER_POLL_INTERVAL_MS=15000
# A detected whale trade older than this can no longer be copied (seconds)
MAX_TRADE_AGE_SECONDS=180
# Assisted execution: how long to wait for a matching fill on the user's wallet (seconds)
ASSISTED_VERIFY_TIMEOUT_SECONDS=1800

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
